{
  "name": "yourweek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4200",
    "build": "node scripts/build-next.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 4201",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test:offline": "playwright test --config playwright.next-offline.config.ts",
    "test:next-dev": "playwright test --config playwright.next-dev.config.ts",
    "test:next-lists": "playwright test --config playwright.next-lists.config.ts",
    "test:next-editor": "playwright test --config playwright.next-editor.config.ts",
    "test:next-backup": "playwright test --config playwright.next-backup.config.ts",
    "test:next-csv": "playwright test --config playwright.next-csv.config.ts",
    "test:next-csv-storage": "playwright test --config playwright.next-csv-storage.config.ts",
    "test:next-placement": "playwright test --config playwright.next-placement.config.ts",
    "test:next-search": "playwright test --config playwright.next-search.config.ts",
    "test:next-acceptance": "playwright test --config playwright.next-acceptance.config.ts",
    "test:next-rollover": "playwright test --config playwright.next-rollover.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check src app tests scripts *.json *.ts *.mjs README.md",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
