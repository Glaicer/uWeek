{
  "name": "yourweek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:next": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4200",
    "build": "node scripts/build.mjs",
    "build:next": "node scripts/build-next.mjs",
    "start:next": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 4201",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "test:offline:next": "playwright test --config playwright.next-offline.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check src app tests scripts *.json *.ts *.mjs index.html README.md",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "dependencies": {
    "next": "16.3.8",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
