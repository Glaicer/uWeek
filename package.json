{
  "name": "yourweek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:up && NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4200",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 4201",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src app tests *.json *.ts *.mjs README.md",
    "test": "pnpm db:up && vitest run",
    "test:e2e": "pnpm db:up && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "better-auth": "1.7.23",
    "drizzle-orm": "0.45.4",
    "next": "16.3.8",
    "pg": "8.23.1",
    "rate-limiter-flexible": "11.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.38.1",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  }
}
