# Postgres from `docker compose up -d`
DATABASE_URL=postgres://yourweek:yourweek@127.0.0.1:5433/yourweek

# better-auth: random secret (`openssl rand -base64 32`) and the public origin of the app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4200

# Resend: API key and a sender on a verified domain
RESEND_API_KEY=
MAIL_FROM=YourWeek <login@example.com>

# Development and tests only: write sign-in emails as JSON files here instead of sending them
# MAIL_OUTBOX_DIR=.outbox
